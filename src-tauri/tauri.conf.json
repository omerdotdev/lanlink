{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanlink",
  "version": "1.0.0",
  "identifier": "dev.lanlink.app",
  "build": {
    "beforeDevCommand": "npm run build:watch",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "http://127.0.0.1:7420",
        "title": "Lanlink",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist"]
  }
}
